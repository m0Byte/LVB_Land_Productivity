```{r}
# Calculation of annual NDVI integrals

#Here six bimonthly NDVI rasters are summed pixel by pixel for each year

years <- sort(
  unique(pairs$year)
)

annual_ndvi_list <- list()

for (yr in years) {

  # Identify the six NDVI periods belonging to the year
  yr_idx <- which(
    pairs$year == yr
  )

  # Stack the six bimonthly NDVI rasters
  yr_stack <- rast(
    ndvi_stack_list[yr_idx]
  )

  # Pixel wise annual sum
  yr_sum <- sum(
    yr_stack,
    na.rm = TRUE
  )

  # file name
  out_name <- file.path(
    ndvi_dir,
    paste0(
      "ndvi_annual_sum_",
      yr,
      ".tif"
    )
  )

  # Save annual NDVI integral
  writeRaster(
    yr_sum,
    out_name,
    overwrite = TRUE
  )

  annual_ndvi_list[
    [as.character(yr)]
  ] <- yr_sum

  cat(
    "year :",
    yr,
    "\n"
  )
}

```

```{r}
# Creating annual NDVI stack

annual_ndvi_stack <- rast(
  annual_ndvi_list
)

names(
  annual_ndvi_stack
) <- names(
  annual_ndvi_list
)

writeRaster(
  annual_ndvi_stack,
  file.path(
    ndvi_dir,
    "ndvi_annual_stack_sum_1997_2024.tif"
  ),
  overwrite = TRUE
)


```


```{r}
# plot
# First year
plot(
  annual_ndvi_stack[[1]]
)

