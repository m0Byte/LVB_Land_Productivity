
```{r}
#Packages
library(terra)
library(ggplot2)

```

```{r}
# Directories
output_dir <- "clipped_output"
ndvi_dir   <- "ndvi_output"
```

```{r}
# Identifying the cropped NIR and Red bands

clipped_files <- list.files(
  output_dir,
  pattern = "\\.tif$",
  full.names = TRUE
)

red_files <- clipped_files[
  grepl("^red_", basename(clipped_files))
]

nir_files <- clipped_files[
  grepl("^nir_", basename(clipped_files))
]
```

```{r}
# Matching Red and NIR bands by dates

get_period_key <- function(path) {
  sub("^(red|nir)_", "", basename(path))
}

red_keys <- sapply(red_files, get_period_key)
nir_keys <- sapply(nir_files, get_period_key)

# Merging
pairs <- merge(
  data.frame(
    key = red_keys,
    red = red_files,
    stringsAsFactors = FALSE
  ),
  data.frame(
    key = nir_keys,
    nir = nir_files,
    stringsAsFactors = FALSE
  ),
  by = "key"
)

```

```{r}

# Extracting dates 

extract_start_date <- function(key) {

  date_string <- regmatches(
    key,
    regexpr("[0-9]{8}", key)
  )

  as.Date(
    date_string,
    format = "%Y%m%d"
  )
}

pairs$period_start <- extract_start_date(pairs$key)

pairs$year <- as.numeric(
  format(pairs$period_start, "%Y")
)

# Sorting pairs in order
pairs <- pairs[
  order(pairs$period_start),
]
```

```{r}
# Biomonthly NDVI calculation

ndvi_stack_list <- vector(
  mode = "list",
  length = nrow(pairs)
)

for (i in seq_len(nrow(pairs))) {

  red_r <- rast(pairs$red[i])
  nir_r <- rast(pairs$nir[i])

  # Remove non-valid reflectance values
  red_r[red_r <= 0] <- NA
  nir_r[nir_r <= 0] <- NA

  # Calculate NDVI
  ndvi_r <- (
    nir_r - red_r
  ) / (
    nir_r + red_r
  )

```

```{r}
saving output

  # File name
  out_name <- file.path(
    ndvi_dir,
    paste0(
      "ndvi_",
      pairs$key[i]
    )
  )

  # Save bimonthly raster
  writeRaster(
    ndvi_r,
    out_name,
    overwrite = TRUE
  )

  ndvi_stack_list[[i]] <- ndvi_r
```

```{r}
# Creating a bimonthly NDVI stack

ndvi_stack <- rast(
  ndvi_stack_list
)

names(ndvi_stack) <- format(
  pairs$period_start,
  "%Y-%m"
)
```

```{r}
# Basin wide mean NDVI time series(for vizuals)

profile_df <- data.frame(

  date = pairs$period_start,

  mean_ndvi = sapply(
    ndvi_stack_list,
    function(x) {

      global(
        x,
        "mean",
        na.rm = TRUE
      )[1, 1]

    }
  )
)

head(profile_df)


# Save bimonthly mean NDVI values
write.csv(
  profile_df,
  file.path(
    ndvi_dir,
    "ndvi_profile_bimonthly.csv"
  ),
  row.names = FALSE
)
```

```{r}
# Plotting bimonthly mean NDVI 

ggplot(
  profile_df,
  aes(
    x = date,
    y = mean_ndvi
  )
) +
  geom_line() +
  geom_point(size = 1) +
  scale_x_date(
    date_breaks = "2 years",
    date_labels = "%Y"
  ) +
  labs(
    title = "Bimonthly Mean NDVI, 1997–2024",
    x = "Year",
    y = "Mean NDVI"
  ) +
  theme_classic()

```

